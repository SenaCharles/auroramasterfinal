/* ============================================================
   AURORA — base.css
   Fundamentos compartilhados por TODAS as páginas:
   variáveis, reset, tipografia, botões, header, drawer,
   footer, FAB/modal SOS, toast, bottom-nav.
   Cada página tem seu próprio CSS de layout além deste.
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  /* Paleta */
  --rose-petal:    #F7E8EE;
  --rose-light:    #FAEEF3;
  --lavender-warm: #C9A4D0;
  --lavender-light:#EDE4F5;
  --aurora-gold:   #E8A87C;
  --rose-deep:     #D4607A;
  --rose-hover:    #BF4F68;
  --plum:          #7B5EA7;
  --plum-light:    #9B7CC4;
  --dusk:          #2D1F3D;
  --dusk-mid:      #4A3560;
  --white:         #FFFFFF;
  --grey-soft:     #F4F0F8;
  --grey-text:     #6B5E7A;

  --font-display: 'Fraunces', Georgia, serif;
  --font-body:    'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;

  --space-xs:  0.5rem;
  --space-sm:  1rem;
  --space-md:  1.5rem;
  --space-lg:  2.5rem;
  --space-xl:  4rem;
  --space-2xl: 6rem;

  --radius-sm:   10px;
  --radius-md:   18px;
  --radius-lg:   26px;
  --radius-pill: 999px;

  --shadow-xs:    0 1px 3px rgba(123, 94, 167, 0.08);
  --shadow-card:  0 4px 20px rgba(123, 94, 167, 0.10), 0 1px 2px rgba(123, 94, 167, 0.06);
  --shadow-float: 0 14px 40px rgba(123, 94, 167, 0.20), 0 2px 8px rgba(123, 94, 167, 0.08);
  --shadow-glow:  0 8px 28px rgba(212, 96, 122, 0.28);

  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

html { scroll-behavior: smooth; font-size: 16px; }

body {
  font-family: var(--font-body);
  background: var(--white);
  color: var(--dusk);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button { cursor: pointer; font: inherit; border: none; background: none; }

::selection { background: var(--rose-deep); color: var(--white); }

:focus-visible {
  outline: 2.5px solid var(--rose-deep);
  outline-offset: 3px;
  border-radius: 4px;
}

/* ─── CONTAINER ────────────────────────────────────────── */
.container { max-width: 1140px; margin: 0 auto; padding: 0 var(--space-md); }
.container--narrow { max-width: 720px; }

/* ─── TIPOGRAFIA ────────────────────────────────────────── */
h1, h2, h3 { font-family: var(--font-display); font-weight: 600; line-height: 1.15; color: var(--dusk); letter-spacing: -0.01em; }
h1 { font-size: clamp(2.1rem, 5vw, 3.5rem); font-weight: 600; letter-spacing: -0.02em; }
h2 { font-size: clamp(1.6rem, 3.5vw, 2.35rem); margin-bottom: var(--space-sm); }
h3 { font-size: 1.3rem; margin-bottom: var(--space-xs); font-weight: 600; }
h4 { font-size: 1rem; font-weight: 600; color: var(--dusk); line-height: 1.4; margin: var(--space-xs) 0; font-family: var(--font-body); }
h1 span {
  background: linear-gradient(100deg, var(--rose-deep) 20%, var(--plum) 80%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
p { color: var(--grey-text); }
.meta { font-size: 0.8rem; color: var(--lavender-warm); letter-spacing: 0.03em; font-weight: 500; }
.eyebrow {
  display: inline-flex; align-items: center; gap: 0.4rem;
  font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--rose-deep); margin-bottom: var(--space-sm);
}
.eyebrow::before { content: ''; width: 18px; height: 2px; background: var(--rose-deep); border-radius: 2px; }
.center { text-align: center; }

/* ─── BOTÕES ────────────────────────────────────────────── */
.btn {
  position: relative; overflow: hidden;
  display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
  padding: 0.8rem 1.7rem; border-radius: var(--radius-pill); font-size: 0.92rem; font-weight: 600;
  transition: background 0.25s var(--ease), transform 0.2s var(--ease), box-shadow 0.25s var(--ease); white-space: nowrap;
}
.btn:active { transform: scale(0.96); }
.btn--primary {
  background: linear-gradient(135deg, var(--rose-deep), var(--plum));
  color: var(--white); box-shadow: var(--shadow-glow);
}
.btn--primary:hover {
  background: linear-gradient(135deg, var(--rose-hover), var(--dusk-mid));
  box-shadow: 0 10px 32px rgba(212, 96, 122, 0.4);
  transform: translateY(-2px);
}
.btn--secondary { background: var(--lavender-light); color: var(--plum); border: 1.5px solid var(--lavender-warm); }
.btn--secondary:hover { background: var(--rose-petal); border-color: var(--rose-deep); transform: translateY(-2px); }
.btn--outline { background: transparent; color: var(--rose-deep); border: 1.5px solid var(--rose-deep); }
.btn--outline:hover { background: var(--rose-petal); transform: translateY(-2px); }
.btn--sm { padding: 0.55rem 1.2rem; font-size: 0.82rem; }
.btn--block { width: 100%; }
.btn--sos {
  width: 100%; background: linear-gradient(135deg, #CF405F, #8B1A35); color: var(--white);
  font-size: 1rem; padding: 0.9rem 1.6rem; border-radius: var(--radius-pill);
  box-shadow: 0 8px 24px rgba(207, 64, 95, 0.4); margin-bottom: var(--space-xs);
}
.btn--sos:hover { filter: brightness(1.1); transform: translateY(-2px); }
.btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none !important; }

.link-cta {
  font-size: 0.88rem; font-weight: 700; color: var(--rose-deep);
  display: inline-flex; align-items: center; gap: 0.3rem; transition: gap 0.25s var(--ease), color 0.2s;
}
.link-cta:hover { gap: 0.55rem; color: var(--rose-hover); }
.link-cta--sm { font-size: 0.8rem; }

/* ─── TAGS / CATEGORIA (reutilizado em várias páginas) ───── */
.tag {
  display: inline-block; padding: 0.24rem 0.75rem; border-radius: var(--radius-pill);
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;
}
.tag--emo   { background: #EDE4F5; color: var(--plum); }
.tag--abuso { background: #FCE4EC; color: #BF4F68; }
.tag--rel   { background: #E0F5F1; color: #2E7B6F; }
.tag--sex   { background: #ECEFF6; color: var(--dusk-mid); }

.badge { display: inline-block; padding: 0.24rem 0.85rem; border-radius: var(--radius-pill); font-size: 0.7rem; font-weight: 700; }
.badge--ok { background: #E0F5F1; color: #2E7B6F; }

/* ─── SEÇÕES GENÉRICAS (reutilizadas por várias páginas) ── */
.section { padding: var(--space-2xl) 0; }
.section--alt { background: var(--grey-soft); }
.section__head {
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-bottom: var(--space-lg); flex-wrap: wrap; gap: var(--space-sm);
}

/* ─── PAGE HERO (banner de topo, usado em páginas internas) ── */
.page-hero {
  background: linear-gradient(160deg, var(--rose-light) 0%, var(--lavender-light) 55%, var(--white) 100%);
  padding: var(--space-xl) 0 var(--space-lg);
  text-align: center;
}
.page-hero h1 { margin-bottom: var(--space-xs); }
.page-hero p { max-width: 56ch; margin: 0 auto; font-size: 1.08rem; line-height: 1.7; }
.breadcrumb { font-size: 0.8rem; color: var(--lavender-warm); margin-bottom: var(--space-sm); font-weight: 500; }
.breadcrumb a { color: var(--plum); font-weight: 700; }
.breadcrumb a:hover { text-decoration: underline; }

/* ─── ACCORDION (reutilizado em Segurança e outras páginas) ── */
.accordion { display: flex; flex-direction: column; gap: 0.6rem; margin-top: var(--space-md); }
.accordion__item { border: 1.5px solid rgba(201, 164, 208, 0.3); border-radius: var(--radius-md); overflow: hidden; background: var(--white); transition: border-color 0.2s, box-shadow 0.2s; }
.accordion__item:hover { border-color: var(--rose-deep); }
.accordion__item.is-open { box-shadow: var(--shadow-card); border-color: var(--rose-deep); }
.accordion__trigger {
  width: 100%; text-align: left; padding: var(--space-sm) var(--space-md); font-size: 0.95rem; font-weight: 700;
  color: var(--dusk); display: flex; justify-content: space-between; align-items: center; transition: background 0.2s;
}
.accordion__trigger:hover { background: var(--grey-soft); }
.accordion__trigger span { font-size: 1.3rem; color: var(--rose-deep); font-weight: 300; transition: transform 0.25s var(--ease); }
.accordion__panel { display: none; padding: 0 var(--space-md) var(--space-md); }
.accordion__panel p { font-size: 0.9rem; }
.accordion__item.is-open .accordion__panel { display: block; }
.accordion__item.is-open .accordion__trigger span { transform: rotate(45deg); display: inline-block; }

/* ═══════════════════════════════════════════════════════════
   HEADER (idêntico em todas as páginas)
═══════════════════════════════════════════════════════════ */
.header {
  position: sticky; top: 0; z-index: 100;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(14px) saturate(160%); -webkit-backdrop-filter: blur(14px) saturate(160%);
  border-bottom: 1px solid rgba(201, 164, 208, 0.22);
  transition: box-shadow 0.3s var(--ease);
}
.header__row { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: var(--space-md); }
.logo {
  font-family: var(--font-display); font-size: 1.6rem; font-weight: 700;
  background: linear-gradient(135deg, var(--rose-deep), var(--plum));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  letter-spacing: -0.02em; flex-shrink: 0; transition: opacity 0.2s;
}
.logo:hover { opacity: 0.8; }
.nav { display: flex; align-items: center; gap: var(--space-lg); flex-wrap: nowrap; }
.nav__link {
  position: relative; font-size: 0.85rem; font-weight: 700; color: var(--grey-text); padding: 0.4rem 0.05rem;
  transition: color 0.2s; white-space: nowrap;
}
.nav__link::after {
  content: ''; position: absolute; left: 0; right: 100%; bottom: 0; height: 2px;
  background: linear-gradient(90deg, var(--rose-deep), var(--plum)); border-radius: 2px;
  transition: right 0.3s var(--ease);
}
.nav__link:hover, .nav__link.is-active { color: var(--dusk); }
.nav__link:hover::after, .nav__link.is-active::after { right: 0; }
.header__actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
.icon-btn {
  display: flex; align-items: center; justify-content: center; width: 38px; height: 38px;
  border-radius: var(--radius-pill); color: var(--grey-text); transition: background 0.2s, color 0.2s, transform 0.2s;
}
.icon-btn:hover { background: var(--rose-petal); color: var(--rose-deep); transform: scale(1.05); }
.avatar-btn {
  width: 36px; height: 36px; border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--lavender-warm), var(--plum)); color: var(--white);
  font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; letter-spacing: 0.04em;
  transition: transform 0.2s;
}
.avatar-btn:hover { transform: scale(1.06); }
.hamburger { display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px; width: 38px; height: 38px; }
.hamburger span { display: block; width: 22px; height: 2px; background: var(--dusk); border-radius: 2px; transition: all 0.3s var(--ease); }
.hamburger.is-active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger.is-active span:nth-child(2) { opacity: 0; }
.hamburger.is-active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ─── DRAWER (menu mobile) ──────────────────────────────── */
.drawer {
  position: fixed; top: 0; right: 0; width: 280px; height: 100vh; background: var(--white);
  box-shadow: var(--shadow-float); z-index: 200; display: flex; flex-direction: column;
  padding: 88px var(--space-lg) var(--space-lg); gap: var(--space-sm);
  transform: translateX(110%); transition: transform 0.35s var(--ease);
}
.drawer.is-open { transform: translateX(0); }
.drawer__link { font-size: 1.1rem; font-weight: 600; color: var(--dusk); padding: var(--space-xs) 0; border-bottom: 1px solid var(--grey-soft); transition: color 0.2s, padding-left 0.2s; }
.drawer__link:hover, .drawer__link.is-active { color: var(--rose-deep); padding-left: 0.35rem; }
.drawer-overlay { display: none; position: fixed; inset: 0; background: rgba(45, 31, 61, 0.45); backdrop-filter: blur(2px); z-index: 190; }
.drawer-overlay.is-open { display: block; }

/* ═══════════════════════════════════════════════════════════
   FOOTER (idêntico em todas as páginas)
═══════════════════════════════════════════════════════════ */
.footer { background: var(--dusk); padding: var(--space-xl) 0 calc(var(--space-xl) + 60px); color: rgba(255,255,255,0.65); position: relative; }
.footer::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--rose-deep), var(--plum), var(--aurora-gold)); }
.footer__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: var(--space-lg); margin-bottom: var(--space-lg); }
.logo--footer { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: var(--white); margin-bottom: 0.5rem; }
.footer .meta { color: rgba(255,255,255,0.45); }
.footer p { color: rgba(255,255,255,0.55); font-size: 0.9rem; max-width: 34ch; line-height: 1.7; }
.footer h5 { color: var(--white); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: var(--space-sm); font-weight: 700; }
.footer__links { list-style: none; display: flex; flex-direction: column; gap: 0.65rem; }
.footer__links a { font-size: 0.88rem; color: rgba(255,255,255,0.65); transition: color 0.2s, padding-left 0.2s; }
.footer__links a:hover { color: var(--lavender-warm); padding-left: 0.25rem; }
.footer__bottom {
  border-top: 1px solid rgba(255,255,255,0.12); padding-top: var(--space-md);
  display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-sm);
}

/* ─── FAB (Floating Action Button) ─────────────────────── */
.fab {
  position: fixed; bottom: 88px; right: 20px; z-index: 120; width: 54px; height: 54px; border-radius: 50%;
  background: linear-gradient(135deg, var(--rose-deep), var(--plum)); color: var(--white);
  box-shadow: var(--shadow-glow); display: flex; align-items: center; justify-content: center;
  transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
}
.fab:hover { transform: scale(1.1) rotate(-4deg); box-shadow: 0 10px 32px rgba(212, 96, 122, 0.5); }

/* ─── MODAL / SOS ───────────────────────────────────────── */
.modal-overlay {
  display: none; position: fixed; inset: 0; background: rgba(45, 31, 61, 0.55); backdrop-filter: blur(3px); z-index: 300;
  align-items: center; justify-content: center; padding: var(--space-md);
}
.modal-overlay.is-open { display: flex; animation: fadeIn 0.25s var(--ease); }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.modal {
  background: var(--white); border-radius: var(--radius-lg); padding: var(--space-lg); width: 100%;
  max-width: 400px; position: relative; box-shadow: 0 30px 72px rgba(45, 31, 61, 0.3);
  animation: modalPop 0.3s var(--ease);
}
@keyframes modalPop { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
.modal__close {
  position: absolute; top: 1rem; right: 1rem; width: 32px; height: 32px; border-radius: 50%;
  background: var(--grey-soft); color: var(--grey-text); font-size: 0.9rem;
  display: flex; align-items: center; justify-content: center; transition: background 0.2s, transform 0.2s;
}
.modal__close:hover { background: var(--rose-petal); color: var(--rose-deep); transform: rotate(90deg); }
.sos-modal h3 { font-family: var(--font-display); margin-bottom: 0.25rem; color: var(--dusk); }
.sos-modal .meta { margin-bottom: var(--space-md); }
.sos-modal .btn--outline { width: 100%; margin-bottom: var(--space-sm); }
.sos-modal hr { border: none; border-top: 1px solid var(--grey-soft); margin: var(--space-sm) 0; }
.sos-feedback { background: #E0F5F1; color: #2E7B6F; font-size: 0.85rem; padding: 0.65rem 1rem; border-radius: var(--radius-md); margin-bottom: var(--space-xs); font-weight: 700; }

.security-row { display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 0; border-bottom: 1px solid var(--grey-soft); font-size: 0.9rem; color: var(--dusk); }
.security-row:last-child { border-bottom: none; }

.toggle { position: relative; display: inline-block; width: 42px; height: 24px; }
.toggle input { opacity: 0; width: 0; height: 0; }
.toggle__track { position: absolute; inset: 0; background: #D8CFEA; border-radius: var(--radius-pill); transition: background 0.25s var(--ease); cursor: pointer; }
.toggle__track::after { content: ''; position: absolute; left: 3px; top: 3px; width: 18px; height: 18px; background: var(--white); border-radius: 50%; transition: transform 0.25s var(--ease); box-shadow: 0 1px 4px rgba(0,0,0,0.2); }
.toggle input:checked + .toggle__track { background: linear-gradient(135deg, var(--rose-deep), var(--plum)); }
.toggle input:checked + .toggle__track::after { transform: translateX(18px); }

/* ─── BOTTOM NAV (mobile) ───────────────────────────────── */
.bottom-nav { display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 110; background: rgba(255,255,255,0.92); backdrop-filter: blur(12px); border-top: 1px solid rgba(201, 164, 208, 0.28); padding: 0.4rem 0 env(safe-area-inset-bottom); justify-content: space-around; }
.bottom-nav__item { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 0.65rem; font-weight: 600; color: var(--grey-text); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); transition: color 0.2s, transform 0.2s; }
.bottom-nav__item.is-active { color: var(--rose-deep); transform: translateY(-2px); }
.bn-icon { font-size: 1.15rem; display: block; }

/* ─── TOAST ─────────────────────────────────────────────── */
.toast {
  position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%) translateY(12px);
  background: var(--dusk); color: var(--white); font-size: 0.85rem; font-weight: 500; padding: 0.7rem 1.5rem;
  border-radius: var(--radius-pill); box-shadow: var(--shadow-float); opacity: 0; pointer-events: none;
  transition: opacity 0.3s var(--ease), transform 0.3s var(--ease); z-index: 400; white-space: nowrap;
}
.toast.is-visible { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ─── MODO DISCRETO ──────────────────────────────────────── */
body.is-discrete { filter: grayscale(0.85) brightness(0.98); }
body.is-discrete .logo, body.is-discrete .logo--footer { color: var(--grey-text) !important; -webkit-text-fill-color: var(--grey-text) !important; background: none !important; }
body.is-discrete::after {
  content: "Modo discreto ativo"; position: fixed; top: 8px; left: 50%; transform: translateX(-50%);
  background: var(--dusk); color: var(--white); font-size: 0.7rem; padding: 0.25rem 0.75rem;
  border-radius: var(--radius-pill); z-index: 500; opacity: 0.85;
}

/* ─── RESPONSIVO (compartilhado: header/nav/footer) ─────── */
@media (max-width: 900px) {
  .nav { display: none; }
  .hamburger { display: flex; }
  .bottom-nav { display: flex; }
  .fab { bottom: 84px; }
  .footer { padding-bottom: 90px; }
  .footer__grid { grid-template-columns: 1fr; gap: var(--space-md); }
}

@media (max-width: 480px) {
  h1 { font-size: 1.85rem; }
  h2 { font-size: 1.45rem; }
  .section { padding: var(--space-xl) 0; }
  .footer__bottom { flex-direction: column; text-align: center; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { transition: none !important; animation: none !important; }
}
