/* ============================================================
   consentimento.css — estilos exclusivos do artigo "Consentimento: por que conversar sobre isso importa"
   (depende de base.css, que já traz header/footer/botões)
   ============================================================ */

/* Barra de progresso de leitura */
.reading-progress {
  position: fixed; top: 64px; left: 0; height: 3px; width: 0%;
  background: linear-gradient(90deg, var(--rose-deep), var(--plum)); z-index: 150; transition: width 0.1s linear;
}

.category-pill {
  display: inline-flex; align-items: center; padding: 0.25rem 0.9rem; border-radius: var(--radius-pill);
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: var(--space-sm);
}
.category-pill--emo   { background: var(--lavender-light); color: var(--plum); }
.category-pill--abuso { background: #FCE4EC; color: #BF4F68; }
.category-pill--rel   { background: #E0F5F1; color: #2E7B6F; }
.category-pill--sex   { background: #ECEFF6; color: var(--dusk-mid); }

.article-wrap { background: linear-gradient(180deg, var(--rose-light) 0%, var(--white) 220px); padding-top: var(--space-xl); padding-bottom: var(--space-2xl); }
.blog-article { max-width: 720px; margin: 0 auto; padding: 0 var(--space-md); }

.blog-article > header { margin-bottom: var(--space-lg); padding-bottom: var(--space-lg); border-bottom: 1px solid rgba(201, 164, 208, 0.25); }
.blog-article > header h1 { font-family: var(--font-display); font-size: clamp(1.65rem, 4vw, 2.5rem); font-weight: 700; line-height: 1.2; color: var(--dusk); margin-bottom: var(--space-sm); }
.blog-article > header p { font-size: 1.1rem; line-height: 1.8; color: var(--grey-text); }

.article-meta { display: flex; align-items: center; gap: var(--space-sm); margin-top: var(--space-sm); font-size: 0.8rem; color: var(--lavender-warm); letter-spacing: 0.03em; }
.article-meta span::before { content: "·"; margin-right: var(--space-sm); }
.article-meta span:first-child::before { content: ""; margin-right: 0; }

.blog-article section { margin-bottom: var(--space-lg); }
.blog-article h2 { font-family: var(--font-display); font-size: clamp(1.1rem, 2.5vw, 1.4rem); font-weight: 700; color: var(--plum); line-height: 1.3; margin-bottom: var(--space-sm); padding-left: var(--space-sm); border-left: 3px solid var(--rose-deep); }
.blog-article p { font-size: 1rem; line-height: 1.85; color: var(--grey-text); margin-bottom: var(--space-sm); }
.blog-article p:last-child { margin-bottom: 0; }

.blog-article ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; margin: var(--space-xs) 0 var(--space-sm); padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-lg); background: var(--grey-soft); border-radius: var(--radius-md); border-left: 3px solid var(--lavender-warm); }
.blog-article ul li { font-size: 0.95rem; color: var(--dusk-mid); line-height: 1.65; padding-left: 1.1rem; position: relative; }
.blog-article ul li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 6px; height: 6px; border-radius: 50%; background: var(--rose-deep); }

.blog-article blockquote { background: var(--rose-petal); border-left: 4px solid var(--rose-deep); border-radius: 0 var(--radius-md) var(--radius-md) 0; padding: var(--space-sm) var(--space-md); margin: var(--space-sm) 0; font-style: italic; color: var(--dusk); font-size: 0.98rem; }

.article-hero-img { width: 100%; aspect-ratio: 16/8; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-card); margin-bottom: var(--space-lg); }

.article-author { display: flex; align-items: center; gap: 0.75rem; margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid rgba(201, 164, 208, 0.25); }
.article-author__avatar { width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--lavender-warm), var(--plum)); color: var(--white); font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.article-author strong { display: block; font-size: 0.9rem; color: var(--dusk); }
.article-author span { font-size: 0.8rem; color: var(--grey-text); }

.article-cta { background: linear-gradient(135deg, var(--rose-petal), var(--lavender-light)); border-radius: var(--radius-lg); padding: var(--space-lg); text-align: center; margin: var(--space-lg) 0; }
.article-cta h3 { color: var(--dusk); margin-bottom: 0.4rem; }
.article-cta p { margin-bottom: var(--space-sm); max-width: 46ch; margin-left: auto; margin-right: auto; }

.related-articles { max-width: 720px; margin: 0 auto; padding: 0 var(--space-md) var(--space-2xl); }
.related-articles h2 { font-family: var(--font-display); font-size: 1.3rem; color: var(--dusk); margin-bottom: var(--space-md); border: none; padding: 0; }
.related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--space-md); }
.related-card { background: var(--white); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-card); transition: transform 0.2s, box-shadow 0.2s; display: block; }
.related-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-float); }
.related-card img { height: 110px; width: 100%; object-fit: cover; }
.related-card__body { padding: var(--space-sm); }
.related-card h4 { font-size: 0.9rem; margin: 0.25rem 0 0; color: var(--dusk); }

@media (max-width: 480px) {
  .blog-article > header h1 { font-size: 1.5rem; }
  .blog-article h2 { font-size: 1.05rem; }
  .blog-article p { font-size: 0.95rem; }
}
